<?xml version="1.0" ?>
<robot name="ROS2" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="Front Left Lower_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="Front Left Lower">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="Front Left Lower_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

