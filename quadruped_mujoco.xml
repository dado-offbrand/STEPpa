  <contact>
    <!-- Exclude shoulder from touching body -->
    <exclude body1="robot_chassis" body2="Front_Left_Shoulder_1"/>
    <exclude body1="robot_chassis" body2="Fright_Right_Shoulder_1"/>
    <exclude body1="robot_chassis" body2="Back_Left_Shoulder_1"/>
    <exclude body1="robot_chassis" body2="Back_Right_Shoulder_1"/>

    <!-- Exclude lower legs from touching upper legs -->
    <exclude body1="Front_Left_Lower_1" body2="Front_Left_Upper_1"/>
    <exclude body1="Front_Right_Lower_1" body2="Front_Right_Upper_1"/>
    <exclude body1="Back_Left_Lower_1" body2="Back_Left_Upper_1"/>
    <exclude body1="Back_Right_Lower_1" body2="Back_Right_Upper_1"/>

    <!-- Exclude foot from touching upper leg -->
    <!--<exclude body1="Front_Left_Foot_1" body2="Front_Left_Upper_1"/>
    <exclude body1="Front_Right_Foot_1" body2="Front_Right_Upper_1"/>
    <exclude body1="Back_Left_Foot_1" body2="Back_Left_Upper_1"/>
    <exclude body1="Back_Right_Foot_1" body2="Back_Right_Upper_1"/>-->
  </contact>

  <default>
    <default class="shoulder">
      <position gear="1" kp="100" kv="2" ctrlrange="-3.14 3.14" ctrllimited="true" forcerange="-11 11" forcelimited="true"/>
    </default>

    <default class="upper_front">
      <position gear="1" kp="100" kv="2" ctrlrange="-3.14 3.14" ctrllimited="true" forcerange="-11 11" forcelimited="true"/>
