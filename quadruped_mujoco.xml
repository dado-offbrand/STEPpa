    <default class="lower_front">
      <position gear="1" kp="100" kv="2" ctrlrange="-3.14 3.14" ctrllimited="true" forcerange="-11 11" forcelimited="true"/>
    </default>

    <default class="upper_back">
      <position gear="1" kp="100" kv="2" ctrlrange="-3.14 3.14" ctrllimited="true" forcerange="-11 11" forcelimited="true"/>
    </default>

    <default class="lower_back">
      <position gear="1" kp="100" kv="2" ctrlrange="-3.14 3.14" ctrllimited="true" forcerange="-11 11" forcelimited="true"/>
    </default>
  </default>

  <actuator>
    <!-- Front Left Leg -->
    <position class="shoulder" joint="Front Left Shoulder"/>
    <position class="upper_front" joint="Front Left Upper"/>
    <position class="lower_front" joint="Front Left Lower"/>

    <!-- Front Right Leg -->
    <position class="shoulder" joint="Front Right Shoulder"/>
    <position class="upper_front" joint="Front Right Upper"/>
    <position class="lower_front" joint="Front Right Lower"/>

    <!-- Back Left Leg -->
    <position class="shoulder" joint="Back Left Shoulder"/>
    <position class="upper_back" joint="Back Left Upper"/>
    <position class="lower_back" joint="Back Left Lower"/>

    <!-- Back Right Leg -->
    <position class="shoulder" joint="Back Right Shoulder"/>
    <position class="upper_back" joint="Back Right Upper"/>
    <position class="lower_back" joint="Back Right Lower"/>
  </actuator>
